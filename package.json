{
  "name": "commie-talent-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dev:worker": "wrangler dev --env staging --port 8790",
    "dev:scheduled": "node scripts/dev-scheduled.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts tests/*.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/password.test.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy": "npm run build && wrangler deploy --env production",
    "test:dom": "node --import ./tests/dom-register.mjs --import tsx --test tests/*.dom.test.tsx"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
